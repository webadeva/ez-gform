# Refuse any push that targets main; changes reach main through pull requests.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is not allowed. Open a pull request instead." >&2
    exit 1
  fi
done

# Offline test gate (turbo cache applies; never forced).
pnpm test
