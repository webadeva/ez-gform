{
  "name": "@ez-gform/react",
  "version": "0.1.4",
  "description": "React hooks for submitting to a Google Form without a backend.",
  "homepage": "https://ez-gform.vercel.app/",
  "type": "module",
  "license": "MIT",
  "bugs": "https://github.com/webadeva/ez-gform/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webadeva/ez-gform.git",
    "directory": "packages/react"
  },
  "keywords": [
    "google-forms",
    "google-form",
    "gform",
    "ez-gform",
    "forms",
    "form-submission",
    "no-backend",
    "serverless",
    "headless-forms",
    "typescript",
    "react",
    "react-hook",
    "hooks",
    "use-google-form",
    "custom-form-ui",
    "form-state",
    "form-validation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@ez-gform/core": "workspace:*",
    "@ez-gform/types": "workspace:*"
  },
  "devDependencies": {
    "@ez-gform/tsconfig": "workspace:*",
    "@kami-ui/eslint-config": "0.0.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "jsdom": "^25.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
