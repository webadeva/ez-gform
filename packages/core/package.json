{
  "name": "@ez-gform/core",
  "version": "0.1.4",
  "description": "Framework-agnostic Google Forms parser, entry encoder, and submitter.",
  "homepage": "https://ez-gform.vercel.app/",
  "author": {
    "name": "Gobind Singh",
    "email": "thesinghgobind@gmail.com",
    "url": "https://www.thegobindsingh.com/"
  },
  "type": "module",
  "license": "MIT",
  "bugs": "https://github.com/webadeva/ez-gform/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webadeva/ez-gform.git",
    "directory": "packages/core"
  },
  "keywords": [
    "google-forms",
    "google-form",
    "gform",
    "ez-gform",
    "forms",
    "form-submission",
    "no-backend",
    "serverless",
    "headless-forms",
    "typescript",
    "form-parser",
    "form-encoder",
    "form-submit",
    "prefill-url",
    "entry-ids",
    "zero-dependency",
    "browser",
    "node",
    "isomorphic"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ez-gform/types": "workspace:*"
  },
  "devDependencies": {
    "@ez-gform/tsconfig": "workspace:*",
    "@kami-ui/eslint-config": "0.0.6",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
